# Скопируйте этот файл в .env и заполните.

# Порт обработчика (nginx проксирует на него /api/lead)
PORT=3005

# Telegram: токен бота от @BotFather и ID чата, куда слать заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта: куда слать заявки
MAIL_TO=
# SMTP для отправки (пример для Яндекс 360 / Яндекс.Почты: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
